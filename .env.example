# Variables que lee docker-compose.yaml (copiar a .env). Todas son opcionales.
# UID/GID: los de tu usuario (id -u / id -g), para que los archivos del volumen no queden como root.
UID=1000
GID=1000

# Interfaz en la que se publican Postgres, Redis y Mailhog. 127.0.0.1 = solo esta máquina.
# Usa 0.0.0.0 únicamente si necesitas entrar desde otra máquina (y cambia las contraseñas).
BIND_ADDRESS=127.0.0.1

APP_PORT=8000
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

DB_DATABASE=agencia
DB_USERNAME=agencia
DB_PASSWORD=secret
